{
    "name": "chuoke/laravel-blog",
    "description": "A standalone blog package for Laravel, providing markdown capabilities, categories, tags, and customizable views.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Chuoke",
            "email": "chuoke@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "league/commonmark": "^2.4",
        "hidehalo/nanoid-php": "^1.1|^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/ai": "^0.11"
    },
    "autoload": {
        "psr-4": {
            "Chuoke\\Blog\\": "src/",
            "Chuoke\\Blog\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chuoke\\Blog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chuoke\\Blog\\Providers\\BlogServiceProvider"
            ],
            "aliases": {
                "Blog": "Chuoke\\Blog\\Facades\\Blog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "laravel/ai": "Required when blog.ai.enabled is true."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
